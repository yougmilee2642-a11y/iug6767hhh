# Frozen evaluation data is hashed byte-for-byte: keep LF on every OS (Windows core.autocrlf would break the check).
demo/track3/** text eol=lf
evaluation/track3/** text eol=lf

# PDF cross-reference records contain format-mandated trailing spaces.
demo/track3/documents/*.pdf binary
demo/track3/documents/*.docx binary
demo/track3/documents/*.xlsx binary
demo/track3/documents/*.pptx binary

# Upstream font/license bytes are preserved verbatim, including the OFL notice whitespace.
static/fonts/jost/Jost.ttf binary
static/fonts/jost/OFL.txt -text -whitespace

# Preserve the primary pytest warning log verbatim (third-party messages include trailing spaces).
docs/track3-release/reports/v2-e7-e9-python.log -whitespace
