GROQ_API_KEY=
# BotFather token; never share .env or put it in an archive.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=true
TELEGRAM_MINIAPP_URL=
# Optional single-owner gate (at least 12 characters). Not multi-tenant auth.
CALLWISE_OWNER_PASSWORD=
BUILDER_MODEL=openai/gpt-oss-20b
SCENARIO_MODEL=openai/gpt-oss-20b
SIMULATOR_MODEL=openai/gpt-oss-20b
JUDGE_MODEL=openai/gpt-oss-20b
# scripted: no additional model calls per user turn; groq: cloud user simulator
SIMULATOR_PROVIDER=scripted
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3
TTS_VOICE=ru-RU-SvetlanaNeural
TTS_RATE=+12%
PUBLIC_ORIGIN=http://127.0.0.1:8000
AGENT_CONFIG_PATH=configs/beauty_salon.json

# Почта бизнеса и SMTP-отправителя
BUSINESS_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloud booking is OPT-IN. Local AI may remain Ollama with LOCAL_ONLY=false.
# LOCAL_ONLY=true blocks all CRM/calendar network calls (including simulations).
CALLWISE_CLOUD_INTEGRATIONS_ENABLED=false
CALLWISE_INTEGRATIONS_FILE=
# Absolute path to owner-managed Google service account JSON; never archive it.
CALLWISE_GOOGLE_CREDENTIALS=
# https://YOUR_PORTAL.bitrix24.by/rest/USER_ID/SECRET/ (CRM scope)
CALLWISE_BITRIX_WEBHOOK=

# Conversation guardrails and consent-before-microphone are ON by default.
CALLWISE_CONVERSATION_SAFETY=true
