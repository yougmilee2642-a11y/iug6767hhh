CALLWISE_LOCAL_ONLY=true
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Коллега без Ollama: адрес и ключ шлюза хоста (их печатает start-gateway.ps1, передаются лично).
# OLLAMA_BASE_URL=http://100.x.y.z:11500
# OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_CONTEXT=8192
OLLAMA_NUM_PREDICT=384
OLLAMA_TIMEOUT=120
LOCAL_STT_PATH=models/gigaam
LOCAL_TTS_PATH=models/silero/v5_ru.pt
LOCAL_TTS_SPEAKER=xenia
# Supported Silero WAV rates: 8000, 24000, 48000. Default: 48000.
LOCAL_TTS_SAMPLE_RATE=48000
LOCAL_CPU_THREADS=6
# auto selects CUDA when available; cuda fails clearly rather than silently using CPU.
LOCAL_STT_DEVICE=cuda
LOCAL_STT_COMPUTE_TYPE=fp16_encoder
LOCAL_TTS_DEVICE=cuda
PUBLIC_ORIGIN=http://127.0.0.1:8000
AGENT_CONFIG_PATH=configs/beauty_salon.json
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=
BUSINESS_EMAIL=
SMTP_HOST=
CALLWISE_OWNER_PASSWORD=

LOCAL_STT_ENGINE=tone_gigaam
LOCAL_SPEAKER_THRESHOLD=0.6
