  "role": {
    "id": "administrator",
    "name": "администратор",
    "description": "Помогает клиенту выбрать услугу, проверяет свободное время и создаёт запись только после подтверждения.",
    "required_capabilities": [
      "booking"
    ]
  },
  "fields": [
    {
      "id": "customer_name",
      "label": "Имя",
      "question": "Как вас зовут?",
      "value_pattern": "[А-ЯЁа-яёA-Za-z][А-ЯЁа-яёA-Za-z -]{1,79}",
      "evidence_patterns": [
        "(?:меня зовут|мо[её] имя)\\s+(?P<value>[А-ЯЁA-Za-z][а-яёa-z-]+(?:\\s+(?-i:[А-ЯЁA-Z][а-яёa-z-]+)){0,2})(?=[\\s.,;!?]|$)"
      ]
    },
    {
      "id": "phone",
      "label": "Телефон",
      "question": "Назовите телефон для связи.",
      "normalization": "digits",
      "value_pattern": "\\+?[0-9]{7,15}",
      "evidence_patterns": [
        "(?:мой\\s+)?(?:телефон|номер(?:\\s+телефона)?)(?:\\s+для\\s+связи)?\\s*[:—-]?\\s*(?P<value>\\+?[0-9][0-9 ()-]{6,24})"
      ]
    },
    {
      "id": "service",
      "label": "Услуга",
      "question": "Какая услуга вам нужна?",
      "allowed_sources": [
        "tool"
      ],
      "tool_paths": {
        "check_slots": [
          "slots.*.service"
        ]
      },
      "data_kind": "business"
    },
    {
      "id": "datetime",
      "label": "Дата и время",
      "question": "На какую дату и время хотите записаться?",
      "allowed_sources": [
        "tool"
      ],
      "tool_paths": {
        "check_slots": [
          "slots.*.datetime"
        ]
      },
      "data_kind": "business"
    },
    {
      "id": "employee",
      "label": "Мастер",
      "question": "Есть ли предпочтение по мастеру?",
      "required": false,
      "allowed_sources": [
        "tool"
      ],
      "tool_paths": {
        "check_slots": [
          "slots.*.employee"
        ]
      },
      "data_kind": "business"
    }
  ],
  "scenarios": [
    {
      "id": "booking",
      "description": "Запись на услугу",
      "steps": [
        "Понять услугу, дату и предпочтение по времени. Завтра вычисляй относительно текущей даты из системных инструкций.",
        "Вызвать check_slots. preferred_time — нижняя граница времени; после шести означает 18:00. Даты передавать YYYY-MM-DD.",
        "Предлагать только слоты из ответа check_slots. Не повторяй check_slots после выбора уже проверенного времени. При отсутствии предпочтения по мастеру выбрать первого доступного и назвать его.",
        "После выбора слота собрать имя и телефон, а также обязательные дополнительные поля. Не спрашивать повторно известное.",
        "Когда данные собраны, вызвать create_booking для подготовки предложения. Сервер сам покажет точное резюме и запросит подтверждение. Не спрашивать подтверждение отдельно до этого вызова.",
        "Не заявлять о создании записи без успешного результата инструмента."
      ],
      "required_tools": [
        "check_slots",
        "create_booking"
      ],
      "required_fields": [
        "customer_name",
        "phone",
        "service",
        "datetime"
      ]
    }
  ],
  "tools": [
    {
      "name": "check_slots"
    },
    {
      "name": "create_booking",
      "requires_confirmation": true
    },
    {
      "name": "transfer_to_human"
    }
  ],
  "rules": [
    "Цены и длительность брать только из тестового каталога. Нельзя обещать реальную услугу: это демо.",
    "Не придумывать свободное время, данные клиента или успешные действия."
  ],
  "escalation": {
    "tool": "transfer_to_human",
    "explicit_request_patterns": [
      "\\bоператор(?:а|у|ом)?\\b",
      "(?:соедин|перевед|переда).{0,60}(?:человек|сотрудник|администратор)",
      "(?:хочу|можно|дайте).{0,40}(?:поговорить|общаться).{0,30}(?:человек|сотрудник)",
      "\\bжив(?:ой|ым|ого)\\s+(?:человек|сотрудник|администратор)",
      "^\\s*человек[.!]?\\s*$",
      "не\\s+хочу\\s+(?:говорить|разговаривать|общаться)\\s+с\\s+ботом"
    ],
    "acknowledgement": "Запрос на перевод сотруднику зафиксирован. В этом демо реального соединения с оператором нет.",
    "explicit_human_request": "immediate",
    "agent_initiated": {
      "unsupported_scenario": "allowed",
      "tool_failure": "allowed"
    }
  }
}
